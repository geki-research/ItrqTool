bin/
obj/
publish/
publish-multifile/

# VS artifacts
.vs/
*.user

# Per-developer Claude Code state (permissions accumulated per machine).
# Reviewed out-of-band, not version-controlled.
.claude/settings.local.json

# Rider
.idea/

# NuGet
*.nupkg
.nuget/

# OS
Thumbs.db
.DS_Store

# Planner artifacts
reports/
diagnostics/

# Live-trial output (generated by test, not committed)
trial-output/

