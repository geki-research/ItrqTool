TestResults/

# Local scratch working dirs
scratch/
scratch-recon/

# Claude Code scheduler lock (ephemeral, per-machine)
.claude/*.lock

# Proprietary auditor template — a REAL asset kept locally, NEVER committed.
# Exact path so the tracked feedback-checklist-template.xlsx sibling is unaffected.
templates/ITRQ_RefYear2025_CustomFormat_Template.xlsx
